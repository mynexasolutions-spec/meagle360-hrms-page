# ── Email / SMTP (contact form leads) ────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Meagle360 HRMS

# Where contact-form leads are delivered
CONTACT_TO_EMAIL=info@meagle360.com

# ── Supabase (blog) ────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection (migrations / admin scripts only)
SUPABASE_DB_URL=

# ── Blog admin login (reference only — not read by the app) ────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudinary (blog image uploads) ────────────
CLOUDINARY_URL=

# ── Conversion tracking (fired on /thank-you) ────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads conversion destination, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion label for the demo-request conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
